# 使用方法：复制本文件为 .env，把 API_KEY 换成你的真实 key（.env 已被 .gitignore 排除，不会被提交）

API_KEY=sk-替换成你的key

# 服务商地址（OpenAI 官方则留空）：
#   Kimi(Moonshot) -> https://api.moonshot.cn/v1   ← 当前默认
#   DeepSeek       -> https://api.deepseek.com
#   通义           -> https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱           -> https://open.bigmodel.cn/api/paas/v4
BASE_URL=https://api.moonshot.cn/v1

# 模型名：
#   Kimi      -> moonshot-v1-8k（moonshot-v1-32k / 128k 也行）
#   DeepSeek  -> deepseek-chat
#   OpenAI    -> gpt-4o-mini
MODEL=moonshot-v1-8k
